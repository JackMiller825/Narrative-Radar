# Copy to .env at the repo root, apps/web/.env, apps/worker/.env, and packages/db/.env
# Placeholders only. Do not put a real secret in this file.

DATABASE_URL=postgresql://radar:radar@127.0.0.1:5432/narrative_radar
REDIS_URL=redis://127.0.0.1:6379
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://127.0.0.1:43123
OWNER_EMAIL=owner@narrativeradar.local
OWNER_PASSWORD=change-me
OWNER_TIMEZONE=UTC
DEMO_SHOW_LOGIN_HINT=true
APP_MODE=demo
DATA_DIR=./data

# Optional. Leave blank until you have access. Do not invent model ids.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_SIZE=

# Optional X recent search. Coverage is limited to your account's API tier.
X_BEARER_TOKEN=
X_SEARCH_QUERY=ethereum lang:en

# Optional Telegram bot token. Pairing happens in the Alerts page.
TELEGRAM_BOT_TOKEN=
